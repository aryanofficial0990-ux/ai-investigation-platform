# Copy this file to .env and fill in your real values.
# Local Neo4j Desktop / Docker default:
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=dummy_password123

# If Member 1 uses Neo4j AuraDB instead, it'll look like:
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=the_aura_generated_password
